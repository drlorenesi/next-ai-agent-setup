# Copy this file to `.env.local` in the new project:  cp .env.example .env.local
# Only fill in the sections for the databases the project actually uses.

# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
# Public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────
# Generate a strong random secret:
#   node -p "crypto.randomBytes(32).toString('hex')"
BETTER_AUTH_SECRET=

# (Optional) Comma-separated list of additional trusted origins for Better Auth.
# Required when testing from other devices on your local network (e.g. iPhone/Android).
# Set this to your Mac's LAN IP: http://192.168.x.x:3000
# Find your LAN IP with: ipconfig getifaddr en0
BETTER_AUTH_TRUSTED_ORIGINS=

# Comma-separated email domains allowed to self-register (each starts with "@").
# Exact domain match only (no subdomains). Malformed entries are ignored.
# Empty = nobody can self-register; admins can still create users.
# Avoid public providers like @gmail.com: they open sign-up to anyone.
AUTH_ALLOWED_EMAIL_DOMAINS=@mycompany1.com,@mycompany2.com

# ─────────────────────────────────────────────
# PostgreSQL — Neon, DIRECT endpoint (lib/db/postgres.ts, Better Auth)
# ─────────────────────────────────────────────
# Use the direct host (NO "-pooler" in the hostname): this module relies on
# per-session SET statement_timeout, which transaction-mode poolers discard.
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full
DATABASE_URL=

# (Optional) TLS overrides. Prefer a CA bundle; INSECURE skips cert verification.
# POSTGRES_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# POSTGRES_SSL_INSECURE=false

# ─────────────────────────────────────────────
# MySQL — business data (lib/db/mysql.ts)
# ─────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# (Optional) TLS overrides
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MYSQL_SSL_INSECURE=false

# ─────────────────────────────────────────────
# SQL Server — business data (lib/db/mssql.ts)
# ─────────────────────────────────────────────
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
# (Optional) TLS. Encryption is always on; a local/self-signed server usually
# needs either its CA or INSECURE=true (dev only).
# MSSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# MSSQL_SSL_INSECURE=false

# ─────────────────────────────────────────────
# Email (SMTP / Nodemailer)
# ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
# Set to "true" only for port 465 (SMTPS); use "false" for port 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Display name and address shown in the "From" field
SMTP_FROM="Mi App <noreply@example.com>"

# ─────────────────────────────────────────────
# MCP — read-only database users (see "MCP servers" in README.md)
# ─────────────────────────────────────────────
# Credentials of the SELECT-only `agent_ro` users from db/readonly-users.sql.
# Dev/staging databases only. Neon's MCP uses OAuth and needs nothing here.
# Your MCP client expands these (e.g. ${MCP_MYSQL_URL} in .mcp.json); the
# variables must be exported in the shell that launches the agent.
MCP_MYSQL_URL=
MCP_MSSQL_CONNECTION_STRING=
