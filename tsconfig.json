{
  // Type-checks the parts of kit/ that can run here (the db modules, the
  // sign-up allowlist, scripts) and the kit's tests in tests/. Run with `npm run typecheck`.
  // (Not part of the kit: the new app keeps its own tsconfig; see merge/.)
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    // Relative imports carry the `.ts` extension so plain `node` can run the
    // scripts (and the lib/db modules they import) without tsx.
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    // `@/` = kit/, which mirrors the new app's root.
    "paths": {
      "@/*": ["./kit/*"]
    }
  },
  "include": [
    "kit/lib/**/*.ts",
    "kit/scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  // Drop-in files for the Next.js app. They import next, better-auth, react
  // and nodemailer, which are not installed in this repo.
  "exclude": [
    "node_modules",
    "kit/lib/auth.ts",
    "kit/lib/auth-client.ts",
    "kit/lib/email.ts",
    "kit/lib/safe-action.ts",
    "kit/lib/session.ts"
  ]
}
